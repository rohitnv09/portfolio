---
import ContactForm from '../solid/ContactForm'
import SvgIcon from '../ui/SvgIcon.astro'
import type { ContactContent } from '../../types/portfolio'

interface Props {
  contact: ContactContent
}

const { contact } = Astro.props
const web3FormsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY
---

<section id="contact" class="relative overflow-hidden py-28">
  <div class="pattern-dots fade-edges absolute inset-0 z-0"></div>

  <div class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
    <p class="reveal mb-4 inline-flex items-center justify-center gap-2 text-label-14-mono text-zinc-400 text-shadow-subtle">
      <SvgIcon class="size-4 text-orange-200" name="sparkles" />
      {contact.eyebrow}
    </p>
    <h2 class="reveal mb-6 text-heading-48 text-white text-shadow-subtle md:text-heading-56">{contact.heading}</h2>
    <p class="reveal mx-auto mb-8 max-w-2xl text-copy-20 text-zinc-400 text-shadow-subtle">{contact.summary}</p>

    <div class="reveal mb-10 flex flex-wrap justify-center gap-2">
      <span class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-black/60 px-3 py-1.5 text-label-13 text-zinc-300">
        <SvgIcon class="size-4" name="mail" />
        {contact.email}
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-black/60 px-3 py-1.5 text-label-13 text-zinc-300">
        <SvgIcon class="size-4" name="globe" />
        {contact.location}
      </span>
      <span class="inline-flex items-center gap-2 rounded-full border border-zinc-800 bg-black/60 px-3 py-1.5 text-label-13 text-zinc-300">
        <SvgIcon class="size-4" name="rocket" />
        {contact.availability}
      </span>
    </div>

    <div class="reveal mb-12 flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap">
      {contact.ctas.map(cta => (
        <a
          class:list={[
            'inline-flex items-center justify-center rounded-full px-6 py-3 text-button-14 transition-all focus:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-black',
            cta.variant === 'primary'
              ? 'bg-white text-black shadow-[0_0_20px_rgba(255,255,255,0.2)] hover:bg-zinc-200'
              : 'border border-zinc-700 text-zinc-300 hover:border-white hover:text-white',
          ]}
          href={cta.href}
          aria-label={cta.isPlaceholder ? `${cta.label} placeholder` : undefined}
        >
          {cta.label}
          {cta.icon && <SvgIcon class="size-4" name={cta.icon} />}
        </a>
      ))}
    </div>

    <ContactForm accessKey={web3FormsAccessKey} client:visible email={contact.email} />
  </div>
</section>
